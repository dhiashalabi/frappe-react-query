{
    "name": "frappe-react-query",
    "version": "2.0.0",
    "description": "TanStack Query SDK for Frappe — query keys, queryOptions, and thin hooks over frappe-js-client.",
    "author": "Dhia A. Shalabi <dhia.shalabi@gmail.com>",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "keywords": [
        "frappe",
        "react",
        "tanstack-query",
        "react-query",
        "hooks",
        "sdk"
    ],
    "homepage": "https://github.com/dhiashalabi/frappe-react-query#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dhiashalabi/frappe-react-query.git"
    },
    "bugs": {
        "url": "https://github.com/dhiashalabi/frappe-react-query/issues"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./extended": {
            "import": {
                "types": "./dist/extended.d.mts",
                "default": "./dist/extended.mjs"
            },
            "require": {
                "types": "./dist/extended.d.ts",
                "default": "./dist/extended.js"
            }
        },
        "./realtime": {
            "import": {
                "types": "./dist/realtime.d.mts",
                "default": "./dist/realtime.mjs"
            },
            "require": {
                "types": "./dist/realtime.d.ts",
                "default": "./dist/realtime.js"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "dev": "vite",
        "build": "tsup && node scripts/verify-dist.mjs",
        "clean": "node -e \"import('node:fs').then((fs) => fs.rmSync('dist',{recursive:true,force:true}))\"",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "preview": "vite preview",
        "prepare": "husky",
        "prepublishOnly": "pnpm build",
        "test": "vitest run --coverage",
        "test:watch": "vitest",
        "coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "format": "prettier --write .",
        "publint": "publint",
        "attw": "attw --pack . --profile node16"
    },
    "peerDependencies": {
        "@tanstack/react-query": "^5.0.0",
        "frappe-js-client": "^3.4.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "socket.io-client": "^4.0.0"
    },
    "peerDependenciesMeta": {
        "socket.io-client": {
            "optional": true
        }
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@base-ui/react": "^1.7.0",
        "@eslint/js": "^10.0.1",
        "@fontsource-variable/inter": "^5.3.0",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/git": "^11.0.1",
        "@semantic-release/github": "^12.0.9",
        "@semantic-release/npm": "^13.1.5",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-query": "^5.102.8",
        "@tanstack/react-table": "^9.2.4",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.4.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/coverage-v8": "^4.1.11",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-perfectionist": "^5.11.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.5",
        "frappe-js-client": "file:../frappe-js-client/packages/client",
        "globals": "^17.11.0",
        "husky": "^9.1.7",
        "jsdom": "^30.0.1",
        "lint-staged": "^17.4.1",
        "lucide-react": "^1.38.0",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "publint": "^0.3.24",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router-dom": "^7.18.3",
        "shadcn": "^4.19.1",
        "socket.io-client": "^4.8.3",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "tsup": "^8.5.1",
        "tw-animate-css": "^1.4.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.69.0",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    },
    "lint-staged": {
        "*.{js,cjs,mjs,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "!(*.js|*.cjs|*.mjs|*.ts|*.tsx)": "prettier --write --ignore-unknown"
    },
    "packageManager": "pnpm@11.24.0",
    "publishConfig": {
        "access": "public"
    }
}
